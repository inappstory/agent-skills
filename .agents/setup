#!/usr/bin/env bash
# Compile the vendor-agnostic config in .agents/ into each vendor's native
# folder. Idempotent. Run once to bootstrap; the Claude SessionStart hook
# reruns it thereafter. `--check` verifies mirrors without writing (exit 1 on
# drift) — that's the self-test.
#
# ponytail: bash + rsync, no compiler. Add a real translator only when a vendor
# needs .agents content reshaped into a different file format (e.g. a settings
# schema). Vendors that read AGENTS.md natively need nothing but a dir + mirror.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

check=0
[[ "${1:-}" == "--check" ]] && check=1

# Vendors that get a mirror of .agents/shared/ (skills, rules, …).
vendors=(.claude .codex .cursor)

drift=0
write() { (( check )) && return 0; "$@"; }

# 1. CLAUDE.md shim — Claude only reads CLAUDE.md, so redirect it at AGENTS.md.
shim="@AGENTS.md"
if [[ ! -f CLAUDE.md || "$(cat CLAUDE.md 2>/dev/null)" != "$shim" ]]; then
  drift=1
  write bash -c 'printf "%s\n" "@AGENTS.md" > CLAUDE.md'
fi

# 2. Mirror the shared payload into every vendor dir.
if [[ -d .agents/shared ]]; then
  for v in "${vendors[@]}"; do
    if (( check )); then
      # settings.json is a generated sibling, not part of the mirror — ignore it.
      if { diff -rq .agents/shared "$v" 2>/dev/null || true; } \
           | grep -Fv "Only in $v: settings.json" | grep -q .; then
        drift=1
      fi
    else
      mkdir -p "$v"
      rsync -a --delete --exclude '/settings.json' .agents/shared/ "$v/"
    fi
  done
fi

# 3. Install the Claude SessionStart hook so this recompiles on every session.
settings=".claude/settings.json"
want="$(cat <<'JSON'
{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash .agents/setup" } ] }
    ]
  }
}
JSON
)"
if [[ ! -f "$settings" || "$(cat "$settings" 2>/dev/null)" != "$want" ]]; then
  drift=1
  write mkdir -p .claude
  (( check )) || printf '%s\n' "$want" > "$settings"
fi

if (( check )); then
  (( drift )) && { echo "drift: run '.agents/setup' to recompile" >&2; exit 1; }
  echo "ok: vendor folders in sync"
else
  echo "compiled .agents/ -> ${vendors[*]}"
fi
