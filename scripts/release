#!/usr/bin/env bash
# Cut a release: bump the single source-of-truth version and tag it.
#
# Two install routes read a version, and this keeps them in lockstep:
#   - Claude Code plugin (/plugin install): reads .claude-plugin/plugin.json "version"
#   - skills CLI pinning (npx skills add <url>.git#vX.Y.Z): reads the git tag
#
# The skills CLI's default `update` re-clones HEAD, so it does NOT need a version
# to pull the latest. Tags exist so users can PIN a release, and so the plugin
# manager sees a new number. Per-skill SKILL.md has no version field — the CLI
# ignores it, so we don't carry one.
#
# Usage: scripts/release <x.y.z>
#   Commit your CHANGELOG.md entry first; this expects a clean tree.
set -euo pipefail
cd "$(dirname "$0")/.."

ver="${1:-}"
if [[ ! "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "usage: scripts/release <x.y.z>" >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "working tree not clean — commit CHANGELOG.md first" >&2
  exit 1
fi
if git rev-parse "v$ver" >/dev/null 2>&1; then
  echo "tag v$ver already exists" >&2
  exit 1
fi

node -e 'const f=".claude-plugin/plugin.json",fs=require("fs");const j=JSON.parse(fs.readFileSync(f));j.version=process.argv[1];fs.writeFileSync(f,JSON.stringify(j,null,2)+"\n")' "$ver"

git add .claude-plugin/plugin.json
git commit -m "release: v$ver"
git tag -a "v$ver" -m "v$ver"
echo "Tagged v$ver. Publish with:"
echo "  git push && git push origin v$ver"
